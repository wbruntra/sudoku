{
  "name": "scaffold",
  "module": "index.ts",
  "type": "module",
  "workspaces": [
    "backend",
    "preact-frontend",
    "shared",
    "database"
  ],
  "scripts": {
    "init": "bun run ./scripts/init.ts",
    "setup": "bun install && bun run hooks:install && bun run db:migrate && bun run db:seed",
    "hooks:install": "git config core.hooksPath .githooks",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "dev": "bun run --parallel backend frontend:preact",
    "backend": "bun run --cwd backend api",
    "frontend:preact": "bun run --cwd preact-frontend dev",
    "phone": "bun run --parallel backend phone:frontend",
    "phone:frontend": "bun run --cwd preact-frontend dev:tailnet",
    "build": "bun run --cwd preact-frontend build",
    "deploy": "bun run --cwd preact-frontend deploy",
    "test": "bun run --cwd backend test && bun run --cwd preact-frontend test",
    "lint": "bun run --cwd preact-frontend lint",
    "typecheck": "bun run --cwd backend typecheck && bun run --cwd database typecheck && bun run --cwd preact-frontend typecheck",
    "check": "bun run format:check && bun run typecheck && bun run lint && bun run test",
    "db:generate": "bun run --cwd database db:generate",
    "db:migrate": "bun run --cwd database db:migrate",
    "db:seed": "bun run --cwd database db:seed",
    "db:reset": "bun run --cwd database db:reset"
  },
  "private": true,
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": ">=5"
  }
}
